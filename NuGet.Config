<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	<!-- Add private feeds here if required, e.g.: -->
	<!-- <add key="MyPrivateFeed" value="https://pkgs.dev.azure.com/ORG/_packaging/FEED/nuget/v3/index.json" /> -->
  </packageSources>

  <packageSourceMapping>
	<!-- Allow packages from nuget.org only from the official feed by default -->
	<packageSource key="nuget.org">
	  <package pattern="*" />
	</packageSource>
	<!-- Map private package ID prefixes to private feeds instead of using a wildcard here. Example:
	  <packageSource key="MyPrivateFeed">
		<package pattern="Contoso.*" />
	  </packageSource>
	-->
  </packageSourceMapping>

  <!-- Optional: enable signature validation and trusted signers if you require signed packages. -->
</configuration>
